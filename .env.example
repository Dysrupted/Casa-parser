# Copy to .env — never commit .env
# Optional contact appended to the User-Agent so site operators can reach you.
RADAR_CONTACT=
# Override config / data locations (defaults: ./config, ./data)
RADAR_CONFIG_DIR=
RADAR_DATA_DIR=
# LLM extraction (M2). Alternatively `ant auth login`; without credentials the run is rules-only.
# ANTHROPIC_API_KEY=   (leave commented if you use `ant auth login`: an empty value can shadow the profile)
# Telegram alerts (M5) — see README
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dashboard / API (M7) — see README
RADAR_DASHBOARD_PASSWORD=
RADAR_API_TOKEN=
RADAR_SHARE_TOKEN=
